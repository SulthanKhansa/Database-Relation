# Application
NODE_ENV=development
# 3001 dipakai agar tidak bentrok dengan service lain yang memakai port 3000
PORT=3001

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
# Port di host untuk container PostgreSQL (dipakai docker compose)
POSTGRES_HOST_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bookstore
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Authentication
JWT_SECRET=dev-jwt-secret-please-change
JWT_EXPIRES_IN=86400

# Default admin (dibuat otomatis saat aplikasi pertama kali jalan)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@bookstore.local
ADMIN_PASSWORD=Admin123!
